# Browser-visible: where the Saathi API lives.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only (used by the DEMO session route that stands in for the host backend).
SAATHI_API_URL=http://localhost:8000
SAATHI_HOST_API_KEY=dev-host-key
DEMO_MODE=true
# SAATHI_DEMO_PASSWORD=saathi-demo

# Origins allowed to embed /chat (space separated). Set to your host dashboard origin(s).
# FRAME_ANCESTORS='self' https://dashboard.example.com
