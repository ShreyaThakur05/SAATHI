# Copy to api/.env for local development. Never commit real secrets.
SAATHI_ENV=local
# Seeds demo accounts/data and enables /v1/demo/*. Local demos only; refused when SAATHI_ENV=production.
SAATHI_DEMO_TOOLS_ENABLED=true
SAATHI_LOG_LEVEL=INFO
SAATHI_DATABASE_URL=postgresql+psycopg://saathi:saathi@localhost:5433/saathi
SAATHI_CORS_ORIGINS=["http://localhost:3000"]
# Optional: language-model understanding. Sarvam is preferred when its key is set.
# Get a key at https://indus.sarvam.ai/key-management  (new accounts get free credits)
# SAATHI_SARVAM_API_KEY=
# SAATHI_SARVAM_MODEL=sarvam-105b-conversations
# Optional alternative provider:
# SAATHI_ANTHROPIC_API_KEY=
# SAATHI_LLM_PROVIDER=auto   # auto | sarvam | anthropic | none
